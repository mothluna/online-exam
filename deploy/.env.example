# 复制为 .env 后按需修改；.env 不要提交到 Git（已在 .gitignore 中）
MYSQL_ROOT_PASSWORD=root123456
REDIS_PASSWORD=redis123456
MINIO_USER=minioadmin
MINIO_PASSWORD=minio123456

# 对象存储镜像：默认 RustFS（S3 兼容）。若将来重新获得 MinIO 镜像，改成 minio/minio 即可切回
OBJECT_STORAGE_IMAGE=rustfs/rustfs:latest

